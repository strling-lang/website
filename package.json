{
  "name": "@strling-lang/website",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:css": "node scripts/check-css-compat.mjs",
    "check:regex-docs": "node scripts/check-regex-docs-coverage.mjs",
    "generate:regex-docs": "node scripts/generate-regex-docs-projection.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run check:css && npm run check:regex-docs -- --dist dist && node --test tests/unit/*.test.mjs && node scripts/check-links.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.11.0",
    "@mdn/browser-compat-data": "^8.0.12",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
