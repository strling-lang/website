---
import { docsNavigation } from '@/data/navigation';

interface NavigationItem {
  href: string;
  label: string;
}
interface Props {
  currentPath: string;
  heading?: string;
  navigationLabel?: string;
  overviewHref?: string;
  overviewLabel?: string;
  items?: NavigationItem[];
}
const {
  currentPath,
  heading = 'Documentation',
  navigationLabel = 'Documentation topics',
  overviewHref = '/docs/',
  overviewLabel = 'Overview',
  items = docsNavigation,
} = Astro.props;
---

<aside class="docs-sidebar">
  <p class="eyebrow">{heading}</p>
  <nav aria-label={navigationLabel}>
    <a
      href={overviewHref}
      aria-current={currentPath === overviewHref ? 'page' : undefined}
      >{overviewLabel}</a
    >
    {
      items.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</aside>
