---
import { fourthEdition } from '@/data/release';
import { site } from '@/data/site';
import { regexSurfaces, surfaces } from '@/data/surfaces';
import StatusBadge from './StatusBadge.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand stack-sm">
      <a class="brand" href="/" aria-label="STRling home">
        <span class="brand-mark">
          <img
            src={site.logoUrl}
            alt="STRling silver bell mark"
            width="42"
            height="42"
            loading="lazy"
          />
        </span>
        <span class="brand-word">STRling</span>
      </a>
      <p>
        The Universal Regular Expression Compiler. A readable, composable
        interface for regular-expression capabilities.
      </p>
      <StatusBadge
        label={`${fourthEdition.name} · ${fourthEdition.status}`}
        tone="prerelease"
      />
    </div>

    <div class="footer-column stack-sm">
      <h2>STRling</h2>
      <ul>
        <li><a href="/learn/">Learn</a></li>
        <li><a href={surfaces.strlingDocs.route}>Docs</a></li>
        <li><a href={surfaces.strlingLab.route}>Lab</a></li>
        <li><a href="/packages/">Packages</a></li>
      </ul>
    </div>
    <div class="footer-column stack-sm">
      <h2>RegEx</h2>
      <ul>
        {
          regexSurfaces.map((surface) => (
            <li>
              <a href={surface.route}>{surface.navigationLabel}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="footer-column stack-sm">
      <h2>Project</h2>
      <ul>
        <li><a href="/fourth-edition/">Fourth Edition</a></li>
        <li><a href="/why-strling/">Why STRling</a></li>
        <li><a href="/project/">Open-source project</a></li>
        <li><a href={site.organizationUrl}>GitHub organization</a></li>
        <li><a href={site.sourceUrl}>Website source</a></li>
        <li><a href={site.licenseUrl}>Apache License 2.0</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-meta">
    <span
      >© 2026 STRling Team. Website content and source are open for inspection.</span
    >
    <span class="mono">Readable. Composable. Universal.</span>
  </div>
</footer>
