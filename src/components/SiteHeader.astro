---
import { primaryNavigation, regexNavigation } from '@/data/navigation';
import { site } from '@/data/site';

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) =>
  path === '/' ? path : `/${path.replace(/^\/+|\/+$/g, '')}/`;
const isCurrent = (href: string) => normalizePath(currentPath) === href;
const isRegexDomain = currentPath.startsWith('/regex/');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="STRling home">
      <span class="brand-mark">
        <img
          src={site.logoUrl}
          alt="STRling silver bell mark"
          width="42"
          height="42"
        />
      </span>
      <span class="brand-word">STRling</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary" data-primary-nav>
      {
        primaryNavigation.slice(0, 3).map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <details
        class="regex-nav"
        data-domain-active={isRegexDomain || undefined}
      >
        <summary>RegEx <span aria-hidden="true">▾</span></summary>
        <div class="regex-nav-panel">
          <a
            href="/regex/"
            aria-current={isCurrent('/regex/') ? 'page' : undefined}
          >
            RegEx overview
          </a>
          {
            regexNavigation.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
      {
        primaryNavigation.slice(3).map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="github-link" href={site.organizationUrl}
        >GitHub <span aria-hidden="true">↗</span></a
      >
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open site navigation">Menu</summary>
      <nav class="mobile-nav-panel" aria-label="Mobile" data-primary-nav>
        {
          primaryNavigation.slice(0, 3).map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <div
          class="mobile-nav-group"
          data-domain-active={isRegexDomain || undefined}
        >
          <a
            class="mobile-nav-heading"
            href="/regex/"
            aria-current={isCurrent('/regex/') ? 'page' : undefined}>RegEx</a
          >
          {
            regexNavigation.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
        {
          primaryNavigation.slice(3).map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a href={site.organizationUrl}
          >GitHub <span aria-hidden="true">↗</span></a
        >
      </nav>
    </details>
  </div>
</header>

<script>
  const regexMenus = document.querySelectorAll(
    '.desktop-nav details.regex-nav',
  );

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;

    regexMenus.forEach((menu) => {
      if (!(menu instanceof HTMLDetailsElement)) return;
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
</script>
