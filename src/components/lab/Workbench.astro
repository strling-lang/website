---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { Crumb } from '@/components/Breadcrumbs.astro';
import { operations, runtimes, limits } from '@/lib/regex-lab/interactive';
import { targets } from '@/lib/regex-lab/compiler';
import type { Expected, LabMode } from '@/lib/regex-lab/session';
import pcre242License from '@/lib/regex-lab/wasm/PCRE2-10.42-LICENCE.txt?url&no-inline';
import pcre243License from '@/lib/regex-lab/wasm/PCRE2-10.43-LICENCE.txt?url&no-inline';
import pcre249License from '@/lib/regex-lab/wasm/PCRE2-10.49-LICENCE.txt?url&no-inline';
import '@/styles/workbench.css';

interface Props {
  mode: LabMode;
  crumbs: Crumb[];
  title: string;
}

const { mode, crumbs, title } = Astro.props;
const isStrling = mode === 'strling';
const expectationExamples = (
  [
    { kind: 'boolean', value: false },
    {
      kind: 'matches',
      count: 2,
      captures: [{ match: 1, key: 'name', value: 'alpha' }],
    },
    { kind: 'matches', count: 0 },
    { kind: 'replacement', value: 'result' },
    { kind: 'split', value: ['first', null, 'last'] },
    { kind: 'error', value: 'compile-rejection' },
  ] satisfies Expected[]
)
  .map((example) => JSON.stringify(example))
  .join('\n');
const tabs = [
  ['results', 'Results'],
  ['structure', isStrling ? 'Compiler' : 'Structure'],
  ...(isStrling
    ? [
        ['artifact', 'Artifact'],
        ['compiler-tools', 'Semantic tools'],
      ]
    : []),
  ['tests', 'Tests'],
  ['trace', 'Debugger'],
  ['compare', 'Compare'],
  ['performance', 'Timing'],
  ['sessions', 'Sessions'],
];
---

<lab-workbench data-mode={mode}>
  <header class="container workbench-intro">
    <Breadcrumbs items={crumbs} />
    <h1>{title}</h1>
    <p>
      {
        isStrling
          ? 'Compile semantic source and test the emitted pattern against your data.'
          : 'Run regular expressions, inspect captures, and compare results across engines.'
      }
    </p>
  </header>
  <noscript
    ><p class="container">
      Enable JavaScript to start the local editor and runtime workers.
    </p></noscript
  >
  <section
    class="container workbench"
    aria-label={title + ' workbench'}
    data-workbench
  >
    <div class="workbench-bar">
      <div class="workbench-config">
        {
          isStrling ? (
            <>
              <label>
                Source format
                <select data-field="format" aria-label="Source format">
                  <option value="semantic">Semantic STRling 1.0</option>
                  <option value="simply">Simply builder JSON</option>
                </select>
              </label>
              <label>
                Compiler target
                <select data-field="target" aria-label="Compiler target">
                  {Object.entries(targets).map(([id, target]) => (
                    <option value={id}>{target.label}</option>
                  ))}
                </select>
              </label>
            </>
          ) : (
            <>
              <label>
                Runtime
                <select data-field="runtime" aria-label="Runtime">
                  {Object.entries(runtimes).map(([id, runtime]) => (
                    <option value={id}>{runtime.label}</option>
                  ))}
                </select>
              </label>
              <label>
                Flags
                <input
                  data-field="flags"
                  type="text"
                  maxlength="16"
                  spellcheck="false"
                  autocomplete="off"
                  aria-describedby="workbench-flag-help"
                />
              </label>
            </>
          )
        }
        <label
          >Operation
          <select data-field="operation" aria-label="Operation">
            {
              Object.entries(operations).map(([id, label]) => (
                <option value={id}>{label}</option>
              ))
            }
          </select>
        </label>
      </div>
      <div class="workbench-actions">
        <label class="workbench-check"
          ><input data-field="live" type="checkbox" /> Live</label
        >
        <button
          type="button"
          class="workbench-toolbar-button"
          data-action="tall"
          aria-pressed="false"
          aria-label="Tall editors"
          title="Toggle tall editors"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true"
            ><path d="M10 2v16M6 6l4-4 4 4m-8 8 4 4 4-4"></path></svg
          > Tall
        </button>
        <button
          type="button"
          class="workbench-primary workbench-toolbar-button"
          data-action="run"
          data-execution-state="idle"
          aria-label="Run"
          title="Run (Ctrl/Command+Enter)"
          aria-keyshortcuts="Control+Enter Meta+Enter"
        >
          <svg data-execution-icon="run" viewBox="0 0 20 20" aria-hidden="true"
            ><path d="m6 3 11 7-11 7Z" fill="currentColor" stroke="none"
            ></path></svg
          >
          <svg data-execution-icon="stop" viewBox="0 0 20 20" aria-hidden="true"
            ><rect
              x="4"
              y="4"
              width="12"
              height="12"
              rx="1"
              fill="currentColor"
              stroke="none"></rect></svg
          >
          <span data-output="execution-label">Run</span>
        </button>
      </div>
    </div>
    <p class="workbench-note workbench-run-help">
      {
        isStrling
          ? 'Source edits compile automatically. Run tests the generated pattern against the sample. Live also runs it after edits.'
          : 'Enter a raw pattern without quotes or delimiters. Set flags separately. Live reruns the selected operation after edits.'
      }
    </p>
    {
      !isStrling && (
        <p
          id="workbench-flag-help"
          class="workbench-note"
          data-output="flags"
        />
      )
    }
    <details class="workbench-reference">
      <summary>Runtime limits and licenses</summary>
      <div class="workbench-disclosure-body">
        <p>
          Runs use local browser workers with time and output limits. Python
          downloads its runtime from this site the first time it is used. Match
          and capture ranges include the start and exclude the end.
        </p>
        <ul>
          <li>
            JavaScript uses the browser's RegExp engine and reports UTF-16
            offsets. Split includes captured delimiters using native <code
              >String.split</code
            >.
          </li>
          <li>
            PCRE2 reports UTF-8 byte offsets. The <code>p</code> flag enables Unicode
            properties. Interpreter stepping is available for PCRE2. Native structure
            inspection is partial.
          </li>
          <li>
            Python <code>re</code> reports Unicode code-point offsets. Bytes mode
            encodes text as UTF-8, reports byte offsets and displays values in hex.
            A byte span that splits a Unicode character has no editor range.
          </li>
        </ul>
        <p>
          PCRE2 license downloads for <a href={pcre242License} download
            >PCRE2 10.42</a
          >,
          <a href={pcre243License} download>PCRE2 10.43</a>, and
          <a href={pcre249License} download>PCRE2 10.49</a>. Python runtime
          source and notices are available from
          <a href="https://github.com/pyodide/pyodide">Pyodide</a>.
        </p>
        <p>
          For certified engine evidence, see <a href="/regex/compatibility/"
            >RegEx Compatibility Check</a
          >. Lab results record local execution for the selected input and
          runtime.
        </p>
      </div>
    </details>
    <div class="workbench-replacement" data-output="replacement" hidden>
      <label
        >Replacement
        <textarea
          data-field="replacement"
          rows="2"
          maxlength={limits.replacement}
          spellcheck="false"></textarea>
      </label>
      <label
        >Replacement syntax
        <select data-field="replacementSyntax" aria-label="Replacement syntax">
          <option value="literal">Literal text</option>
          <option value="native">Runtime template</option>
        </select>
      </label>
      <p class="workbench-note">
        Literal text is inserted verbatim. Runtime templates use the engine's
        syntax, such as JavaScript <code>$&lt;name&gt;</code>, PCRE2
        <code>$&#123;name&#125;</code>, or Python <code>\g&lt;name&gt;</code>.
      </p>
    </div>
    <div class="workbench-editors">
      <section aria-labelledby="lab-source-heading" class="workbench-card">
        <header>
          <h2 id="lab-source-heading">{isStrling ? 'Source' : 'Pattern'}</h2>
          <div class="workbench-inline">
            <select
              data-field="working-source"
              aria-label={isStrling
                ? 'Saved working source'
                : 'Saved working pattern'}></select>
            <details class="workbench-menu">
              <summary
                >{isStrling ? 'Manage sources' : 'Manage patterns'}</summary
              >
              <div>
                <button type="button" data-action="new-working">New</button>
                <button type="button" data-action="rename-working"
                  >Rename</button
                >
                <button type="button" data-action="duplicate-working"
                  >Duplicate</button
                >
                <button type="button" data-action="delete-working"
                  >Delete</button
                >
                <button type="button" data-action="find"
                  >Find / replace in editor</button
                >
                <button type="button" data-action="retry-workspace" hidden
                  >Retry autosave</button
                >
                <button type="button" data-action="reset-workspace" hidden
                  >Reset working storage</button
                >
              </div>
            </details>
            <button type="button" data-action="format" hidden
              >Format JSON</button
            >
            <button type="button" data-action="copy-source">Copy</button>
          </div>
        </header>
        <div class="workbench-editor" data-editor="source"></div>
        <footer>
          <span data-output="source-meta"></span>
          <span data-output="workspace-status" role="status"></span>
        </footer>
      </section>
      <section aria-labelledby="lab-subject-heading" class="workbench-card">
        <header>
          <h2 id="lab-subject-heading">Sample text</h2>
          <div class="workbench-inline">
            <select data-field="dataset" aria-label="Dataset"></select>
            <button type="button" data-action="add-dataset">Add dataset</button>
            <details class="workbench-menu">
              <summary>Manage datasets</summary>
              <div>
                <button type="button" data-action="rename-dataset"
                  >Rename</button
                >
                <button type="button" data-action="duplicate-dataset"
                  >Duplicate</button
                >
                <button type="button" data-action="remove-dataset"
                  >Remove</button
                >
                <label
                  >Copy saved dataset <select data-field="reuse-dataset"
                  ></select></label
                >
              </div>
            </details>
          </div>
        </header>
        <div class="workbench-editor" data-editor="subject"></div>
        <footer data-output="subject-meta"></footer>
      </section>
    </div>
    <div class="workbench-status" role="status" data-output="status">
      Loading the workbench…
    </div>

    <div class="workbench-investigation">
      <div class="workbench-tab-bar">
        <div class="workbench-tabs" role="tablist" aria-label="Workbench tools">
          {
            tabs.map(([id, label], index) => (
              <button
                id={'lab-tab-' + id}
                type="button"
                role="tab"
                aria-controls={'lab-panel-' + id}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-tab={id}
              >
                {label}
              </button>
            ))
          }
        </div>
        <div
          class="workbench-tab-actions"
          role="group"
          aria-label="Selected tab actions"
        >
          <button
            type="button"
            data-action="tab-copy"
            aria-label="Copy"
            title="No output to copy"
            disabled
          >
            <svg viewBox="0 0 20 20" aria-hidden="true"
              ><rect x="6" y="6" width="11" height="11" rx="2"></rect><path
                d="M13 3H5a2 2 0 0 0-2 2v8"></path></svg
            >
          </button>
          <button
            type="button"
            data-action="tab-download"
            aria-label="Download"
            title="No output to download"
            disabled
          >
            <svg viewBox="0 0 20 20" aria-hidden="true"
              ><path d="M10 2v11m-4-4 4 4 4-4M3 13v4h14v-4"></path></svg
            >
          </button>
        </div>
      </div>
      <section
        id="lab-panel-results"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="lab-tab-results"
        data-panel="results"
      >
        <p class="workbench-note">
          Copy gives the current result JSON. Download includes the source, run
          settings, and observation details.
        </p>
        <p class="workbench-note" data-output="provenance" hidden></p>
        <div data-output="matches">
          <p>Run to see matches or other output for the selected operation.</p>
        </div>
        <details data-output="continuation-tools" hidden>
          <summary>Scan continuation</summary>
          <div class="workbench-disclosure-body">
            <div
              class="workbench-inline"
              data-output="checkpoint-controls"
              hidden
            >
              <label
                >Continue after match <select data-field="checkpoint-match"
                ></select></label
              >
              <button type="button" data-action="record-cursor"
                >Keep this boundary</button
              >
            </div>
            <p class="workbench-note" data-output="continuation-status"></p>
            <button type="button" data-action="resume-scan" hidden
              >Resume saved scan</button
            >
          </div>
        </details>
        <details data-output="extraction" hidden>
          <summary>Extract matches or captures</summary>
          <div class="workbench-disclosure-body">
            <div class="workbench-inline">
              <label>
                Value to extract
                <select data-field="extraction-value"></select>
              </label>
              <button data-action="export-extraction" type="button">
                Download extracted JSON
              </button>
            </div>
            <p class="workbench-note">
              Values follow match order. Null marks a group that did not
              participate and an empty string marks a participating empty group.
            </p>
            <pre tabindex="0" data-output="extracted-values"></pre>
          </div>
        </details>
        <details data-output="result-details" hidden>
          <summary>Structured result</summary>
          <div class="workbench-disclosure-body">
            <div data-output="result-tree"></div>
            <details>
              <summary>Raw JSON</summary>
              <div class="workbench-disclosure-body">
                <pre data-output="result-json" tabindex="0"></pre>
              </div>
            </details>
          </div>
        </details>
        <details data-output="origin-details" hidden>
          <summary>Generated pattern origin</summary>
          <div class="workbench-disclosure-body">
            <pre data-output="origin-json" tabindex="0"></pre>
          </div>
        </details>
      </section>
      <section
        id="lab-panel-structure"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="lab-tab-structure"
        data-panel="structure"
        hidden
      >
        <div data-output="structure"></div>
      </section>
      {
        isStrling && (
          <section
            id="lab-panel-artifact"
            role="tabpanel"
            tabindex="0"
            aria-labelledby="lab-tab-artifact"
            data-panel="artifact"
            hidden
          >
            <div class="workbench-inline">
              <button data-action="run-artifact" type="button" disabled>
                Run artifact
              </button>
              <button data-action="open-artifact" type="button" disabled>
                Open artifact and samples in RegEx Lab
              </button>
              <button data-action="open-with-cursor" type="button" hidden>
                Open with sample and cursor in RegEx Lab
              </button>
            </div>
            <p class="workbench-note">
              Both handoffs carry the current datasets and compiler origin in
              this tab. The cursor option also includes a saved scan boundary.
              Execution waits for Run or Resume.
            </p>
            <div data-output="artifact" />
          </section>
        )
      }
      {
        isStrling && (
          <section
            id="lab-panel-compiler-tools"
            role="tabpanel"
            tabindex="0"
            aria-labelledby="lab-tab-compiler-tools"
            data-panel="compiler-tools"
            hidden
          >
            <p class="workbench-note" data-output="compiler-tools-status">
              Compiler tools are loading.
            </p>
            <div class="workbench-inline">
              <label>
                Convert to
                <select
                  data-field="conversion-destination"
                  aria-label="Conversion destination"
                >
                  <option value="simply_builder">Simply 1.0 builder</option>
                  <option value="semantic_strling">Semantic STRling 1.0</option>
                </select>
              </label>
              <button type="button" data-action="convert" disabled>
                Convert
              </button>
            </div>
            <div class="workbench-inline">
              <label>
                Explanation scope
                <select
                  data-field="explanation-scope"
                  aria-label="Explanation scope"
                >
                  <option value="target">Selected target profile</option>
                  <option value="semantic">Target-neutral semantics</option>
                </select>
              </label>
              <button type="button" data-action="explain" disabled>
                Explain current subject
              </button>
            </div>
            <div data-output="compiler-tools" />
          </section>
        )
      }
      <section
        id="lab-panel-tests"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="lab-tab-tests"
        data-panel="tests"
        hidden
      >
        <div class="workbench-inline">
          <button data-action="add-test" type="button">Add test</button>
          <button data-action="test-from-result" type="button" disabled
            >Add from result</button
          >
          <button data-action="run-tests" type="button">Run all</button>
          <label class="workbench-file"
            >Import tests <input
              type="file"
              data-field="import-tests"
              accept=".json,application/json"
            /></label
          >
        </div>
        <p class="workbench-note">
          Tests use the current pattern, their own subject and operation, and
          the selected runtime.
        </p>
        <div data-output="tests"></div>
      </section>
      <section
        id="lab-panel-trace"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="lab-tab-trace"
        data-panel="trace"
        hidden
      >
        <p data-output="trace-help"></p>
        <div class="workbench-inline">
          <button data-action="trace" type="button" disabled
            >Trace search</button
          >
          <button data-action="previous-event" type="button" disabled
            >Previous step</button
          >
          <button data-action="next-event" type="button" disabled
            >Next step</button
          >
        </div>
        <div data-output="trace"></div>
      </section>
      <section
        id="lab-panel-compare"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="lab-tab-compare"
        data-panel="compare"
        hidden
      >
        <div class="workbench-inline">
          <label
            >Baseline revision <select
              data-field="baseline"
              aria-label="Baseline revision"></select></label
          >
          <button data-action="compare-revision" type="button"
            >Compare revision</button
          >
          {
            !isStrling && (
              <label>
                Second runtime
                <select data-field="comparison-runtime">
                  {Object.entries(runtimes).map(([id, runtime]) => (
                    <option value={id}>{runtime.label}</option>
                  ))}
                </select>
              </label>
            )
          }
          {
            !isStrling && (
              <button data-action="compare-runtimes" type="button">
                Compare runtimes
              </button>
            )
          }
        </div>
        <p class="workbench-note">
          Each comparison uses current datasets and settings on both sides and
          reports concrete differences.
        </p>
        <div data-output="comparison"></div>
      </section>
      <section
        id="lab-panel-performance"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="lab-tab-performance"
        data-panel="performance"
        hidden
      >
        <div class="workbench-inline">
          <label
            >Subject size <select data-field="size"
              ><option value="1">Current</option><option value="0.5"
                >Half prefix</option
              ><option value="2">Doubled</option></select
            ></label
          >
          <label class="workbench-check"
            ><input type="checkbox" data-field="benchmark-baseline" /> Include baseline
            revision</label
          >
          <button data-action="benchmark" type="button">Measure</button>
        </div>
        <p class="workbench-note">
          One warmup and nine measured runs per candidate. Comparisons run the
          baseline first and the current pattern second in every round. Partial
          experiments retain completed measurements.
        </p>
        <div data-output="performance"></div>
      </section>
      <section
        id="lab-panel-sessions"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="lab-tab-sessions"
        data-panel="sessions"
        hidden
      >
        <div class="workbench-inline">
          <label
            >Session name <input
              type="text"
              data-field="name"
              maxlength="80"
            /></label
          >
          <button data-action="save" type="button">Save revision</button>
          <button data-action="duplicate" type="button">Duplicate</button>
          <button data-action="new-session" type="button">New session</button>
        </div>
        <div class="workbench-inline">
          <label
            >Saved session <select data-field="saved-session"></select></label
          >
          <label>Revision <select data-field="revision"></select></label>
          <button data-action="restore" type="button">Restore</button>
          <button data-action="delete-revision" type="button"
            >Delete revision</button
          >
          <button data-action="delete-session" type="button"
            >Delete session</button
          >
          <button data-action="clear-sessions" type="button"
            >Clear local archive</button
          >
        </div>
        <fieldset>
          <legend>Include in downloaded session</legend>
          <div class="workbench-inline">
            <label class="workbench-check"
              ><input type="checkbox" data-field="share-active-source" /> Active source</label
            >
            <label class="workbench-check"
              ><input type="checkbox" data-field="share-samples" /> Sample data</label
            >
            <label class="workbench-check"
              ><input type="checkbox" data-field="share-replacement" /> Replacement
              text</label
            >
            <label class="workbench-check"
              ><input type="checkbox" data-field="share-tests" /> Tests</label
            >
            <label class="workbench-check"
              ><input type="checkbox" data-field="share-observations" /> Recorded
              outputs</label
            >
            <label class="workbench-check"
              ><input type="checkbox" data-field="share-source" /> Original STRling
              source of generated patterns</label
            >
            <label class="workbench-check"
              ><input type="checkbox" data-field="share-continuation" /> Saved scan
              cursor</label
            >
          </div>
          <p class="workbench-note">
            Use Copy above for a settings-only link. Download uses these
            selections. Tests and recorded outputs can contain source, sample,
            or replacement text. A cursor requires the data bound to its saved
            run.
          </p>
          <div class="workbench-inline">
            <label class="workbench-file"
              >Import session <input
                type="file"
                data-field="import-session"
                accept=".json,application/json"
              /></label
            >
          </div>
          <label data-output="share" hidden
            >Share URL <input
              type="url"
              data-field="share-url"
              readonly
            /></label
          >
        </fieldset>
        <details data-output="recording" hidden>
          <summary>Previously recorded outputs</summary>
          <div class="workbench-disclosure-body">
            <p class="workbench-note">
              Restoring a revision makes these outputs available for inspection.
              Run starts a new observation with the current runtime and inputs.
            </p>
            <pre data-output="recording-json" tabindex="0"></pre>
          </div>
        </details>
      </section>
    </div>
  </section>
  <dialog class="workbench-dialog" data-dialog="test">
    <form data-form="test">
      <h2>Edit test case</h2>
      <label>Name <input name="name" required maxlength="80" /></label>
      <label>Group <input name="group" maxlength="80" /></label>
      <label
        >Subject <textarea name="text" rows="4" maxlength={limits.input}
        ></textarea></label
      >
      <label
        >Operation
        <select name="operation"
          >{
            Object.entries(operations).map(([id, label]) => (
              <option value={id}>{label}</option>
            ))
          }</select
        >
      </label>
      <label>Flags <input name="flags" maxlength="16" /></label>
      <label
        >Replacement <textarea
          name="replacement"
          maxlength={limits.replacement}
          rows="2"></textarea></label
      >
      <label
        >Replacement syntax <select name="replacementSyntax"
          ><option value="literal">Literal text</option><option value="native"
            >Runtime template</option
          ></select
        ></label
      >
      <label
        >Expected result JSON <textarea
          name="expected"
          required
          rows="5"
          spellcheck="false"></textarea></label
      >
      <details class="workbench-reference">
        <summary>Test expectation formats</summary>
        <div class="workbench-disclosure-body">
          <p>
            Enter one JSON object per test. Choose the example for your
            operation.
          </p>
          <pre><code>{expectationExamples}</code></pre>
          <p>
            Use a numbered or named capture key. A <code>null</code> capture value
            expects a defined group that did not participate.
          </p>
          <p>
            Error categories include <code>compile-rejection</code>,
            <code>runtime-error</code>, <code>resource-terminated</code>,
            <code>unsupported-operation</code>, and <code
              >infrastructure-failure</code
            >.
          </p>
        </div>
      </details>
      <p role="alert" data-output="test-error"></p>
      <div class="workbench-inline">
        <button type="submit" class="workbench-primary">Save test</button>
        <button type="button" data-action="cancel-test">Cancel</button>
      </div>
    </form>
  </dialog>
</lab-workbench>

