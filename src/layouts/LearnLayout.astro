---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type Crumb } from '@/components/Breadcrumbs.astro';
import DocsTOC from '@/components/DocsTOC.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description: string;
  summary: string;
  time: string;
  pathname: string;
  crumbs: Crumb[];
  headings: Heading[];
  related: string[];
  keywords: string[];
}
const {
  title,
  description,
  summary,
  time,
  pathname,
  crumbs,
  headings,
  related,
  keywords,
} = Astro.props;
---

<BaseLayout {title} {description} {pathname} {crumbs} {keywords} type="article">
  <div
    class="container docs-shell"
    style="grid-template-columns: minmax(0, 1fr) minmax(0, var(--reading-width)) minmax(160px, 1fr);"
  >
    <div aria-hidden="true"></div>
    <article class="prose">
      <header class="doc-header stack">
        <Breadcrumbs items={crumbs} />
        <div class="cluster">
          <span class="eyebrow">Guided learning</span><span class="mono muted"
            >{time}</span
          >
        </div>
        <h1>{title}</h1>
        <p class="kicker">{summary}</p>
      </header>
      <slot />
      <RelatedLinks links={related} />
    </article>
    <DocsTOC {headings} />
  </div>
</BaseLayout>
