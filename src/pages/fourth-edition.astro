---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { bindings } from '@/data/bindings';
import { fourthEdition } from '@/data/release';
const title = 'STRling Fourth Edition pre-release center';
const description =
  'Verified and provisional information about the STRling Fourth Edition, including ecosystem preparation, documentation readiness, package rollout, and migration status.';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Fourth Edition', href: '/fourth-edition/' },
];
---

<BaseLayout
  {title}
  {description}
  pathname="/fourth-edition/"
  {crumbs}
  keywords={[
    'STRling Fourth Edition',
    'STRling pre-release',
    'regular expression compiler',
  ]}
>
  <header class="page-hero">
    <div class="container reading stack">
      <Breadcrumbs items={crumbs} /><StatusBadge
        label={fourthEdition.status}
        tone="prerelease"
      /><h1>Fourth Edition</h1><p>{fourthEdition.summary}</p><div
        class="callout"
      >
        <strong>No release promise</strong><p>
          No final version number or release date is published here. Those
          details will appear only when the certified release is synchronized
          across packages, docs, and migration guidance.
        </p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Why this edition matters</span><h2>
          One public contract across a broad ecosystem
        </h2><p>
          The Fourth Edition is framed as a coordinated user experience:
          readable APIs, documented behavior, compatibility boundaries,
          packages, and learning material should describe the same concepts.
        </p>
      </div><div class="grid-3">
        <article class="feature stack-sm">
          <span class="feature-number">01</span><h3>Shared vocabulary</h3><p>
            Canonical source shows the Simply API across 17 binding directories,
            using host-language naming conventions around common concepts.
          </p>
        </article><article class="feature stack-sm">
          <span class="feature-number">02</span><h3>
            Specification-backed behavior
          </h3><p>
            The public compiler repository contains formal grammar, semantics, a
            feature registry, and conformance fixtures.
          </p>
        </article><article class="feature stack-sm">
          <span class="feature-number">03</span><h3>
            Portability in the open
          </h3><p>
            The specification records differences among PCRE2, Python, and
            ECMAScript instead of hiding target limitations.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container grid-2">
      <div class="stack">
        <span class="eyebrow">Verified public preparation</span><h2>
          What can be said now
        </h2><ul>
          {fourthEdition.verifiedWork.map((item) => <li>{item}</li>)}
        </ul>
      </div><div class="stack">
        <span class="eyebrow">Still provisional</span><h2>
          What is deliberately not promised
        </h2><ul>{fourthEdition.provisional.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Ecosystem rollout</span><h2>
          Package state is binding-specific
        </h2><p>
          Some packages are already visible in registries, some bindings are
          source-delivered, and some have publication metadata without a
          verified release. None of those states alone certifies a final Fourth
          Edition package.
        </p>
      </div><div style="overflow-x:auto">
        <table class="package-table">
          <thead
            ><tr
              ><th>Binding</th><th>Current public state</th><th>Distribution</th
              ><th>Fourth Edition</th></tr
            ></thead
          ><tbody
            >{
              bindings.map((binding) => (
                <tr>
                  <>
                    <td data-label="Binding">
                      <a href={`/packages/${binding.slug}/`}>
                        {binding.language}
                      </a>
                    </td>
                    <td data-label="Current state">{binding.status}</td>
                    <td data-label="Distribution">{binding.distribution}</td>
                    <td data-label="Fourth Edition">Provisional</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container grid-2">
      <div class="stack">
        <span class="eyebrow">Documentation readiness</span><h2>
          User reference is being organized now
        </h2><p>
          Core concepts, composition, literals, character sets, quantifiers,
          captures, lookarounds, anchors, diagnostics, and compatibility have
          canonical routes. Final edition-specific wording will be synchronized
          with certified behavior.
        </p><a class="text-link" href="/docs/">Browse user documentation</a>
      </div><div class="stack">
        <span class="eyebrow">Migration guidance</span><h2>Not yet final</h2><p>
          The public Python package line and the canonical multi-binding source
          are not represented as interchangeable. Migration instructions will be
          published only after package and compatibility state are certified.
        </p><a class="text-link" href="/packages/python/"
          >Review Python package state</a
        >
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container reading stack">
      <h2>Prepare without guessing</h2><p class="kicker">
        Learn the stable pattern-building concepts, consult compatibility notes,
        and check the package page for your language. Treat edition-specific
        version, date, and migration details as provisional until this page
        changes state.
      </p><div class="cluster">
        <a class="button" href="/learn/tour/">Take the STRling tour</a><a
          class="button button--secondary"
          href="/packages/">Review package status</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
