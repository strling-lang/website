---
import { getCollection } from 'astro:content';
import { difficultyLabels } from '@/data/learn';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { learnLessonPath } from '@/data/navigation';

const lessons = (await getCollection('learn')).sort(
  (a, b) => a.data.order - b.data.order,
);
const title = 'Learn STRling';
const description =
  'Learn STRling fundamentals, build maintainable patterns for real systems, and communicate a nested sequence hypothesis with executable examples.';
const sections = [
  {
    difficulty: 'beginner',
    anchor: 'fundamentals-lessons',
    title: 'Learn the fundamentals',
    intro:
      'Start with core concepts, translate familiar RegEx expressions, and build your first reusable patterns.',
  },
  {
    difficulty: 'advanced',
    anchor: 'advanced-lessons',
    title: 'Compose patterns for real systems',
    intro:
      'Build maintainable pattern systems for production logs, versioned APIs, and configurable data formats.',
  },
  {
    difficulty: 'frontier',
    anchor: 'frontier-lessons',
    title: 'Make complex patterns communicable',
    intro:
      'Express intricate pattern families as readable, executable hypotheses. Make their structure, contextual rules, and assumptions clear enough for someone else to inspect, test, and revise.',
  },
] as const;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn/' },
];
---

<BaseLayout
  {title}
  {description}
  pathname="/learn/"
  {crumbs}
  keywords={['learn STRling', 'readable regex tutorial', 'regex alternative']}
>
  <header class="page-hero">
    <div class="container reading stack">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Guided learning</span>
      <h1>Learn STRling by building patterns</h1>
      <p>
        Choose a short installation path, translate concepts you already know,
        build patterns for production systems, or model and explain a nested
        sequence hypothesis.
      </p>
    </div>
  </header>
  {
    sections.map(({ difficulty, anchor, title: heading, intro }) => (
      <section
        class:list={[
          'section',
          { 'section--bordered': difficulty !== 'beginner' },
        ]}
        aria-labelledby={anchor}
      >
        <div class="container">
          <div class="section-heading">
            <h2 id={anchor}>{heading}</h2>
            <p>{intro}</p>
          </div>
          <div class:list={[difficulty === 'frontier' ? 'reading' : 'grid-3']}>
            {lessons
              .filter(({ data }) => data.difficulty === difficulty)
              .map(({ id, data }) => (
                <article class="package-card">
                  <div class="cluster">
                    <span class="feature-number">
                      {String(data.order).padStart(2, '0')}
                    </span>
                    <span class="mono muted">
                      {data.time} · {difficultyLabels[difficulty]}
                    </span>
                  </div>
                  <h3 style="font-size:1.55rem">{data.title}</h3>
                  <p>{data.summary}</p>
                  <a class="text-link card-link" href={learnLessonPath(id)}>
                    Begin {data.title}
                  </a>
                </article>
              ))}
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>
