---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { productRelease, releaseLabel, supportMatrix } from '@/data/release';
import { bindings } from '@/data/bindings';

export function getStaticPaths() {
  return bindings.map((binding) => ({
    params: { binding: binding.slug },
    props: { binding },
  }));
}
const { binding } = Astro.props;
const title = `STRling for ${binding.language}`;
const description = `${binding.summary} ${binding.distribution} ${binding.package.version}. ${binding.support} tier for ${releaseLabel}.`;
const guide = binding.sourcePath.replace('/tree/', '/blob/') + '/README.md';
const pathname = `/packages/${binding.slug}/`;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Packages', href: '/packages/' },
  { label: binding.language, href: pathname },
];
const tone = binding.status === 'Registry published' ? 'published' : 'source';
---

<BaseLayout
  {title}
  {description}
  {pathname}
  {crumbs}
  type="article"
  keywords={[
    `STRling ${binding.language}`,
    `${binding.language} regex library`,
    'readable regex',
  ]}
>
  <header class="page-hero">
    <div class="container reading stack">
      <Breadcrumbs items={crumbs} /><div class="cluster">
        <span class="eyebrow">Language binding</span><StatusBadge
          label={binding.status}
          {tone}
        />
      </div><h1>STRling for {binding.language}</h1><p>{binding.summary}</p><div
        class="cluster"
      >
        <a class="button" href={binding.package.url}>
          Open {binding.distribution}
          <span aria-hidden="true">↗</span>
        </a><a class="button button--secondary" href={binding.sourcePath}
          >View source <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </header>
  <section class="section">
    <div class="container reading stack">
      <h2>Availability</h2><dl
        class="facts"
        style="grid-template-columns:repeat(2,minmax(0,1fr))"
      >
        <div class="fact">
          <dt>Distribution</dt><dd>{binding.distribution}</dd>
        </div>
        <div class="fact"><dt>Support tier</dt><dd>{binding.support}</dd></div>
        <div class="fact"><dt>Package</dt><dd>{binding.package.name}</dd></div>
        <div class="fact">
          <dt>Version or tag</dt><dd>{binding.package.version}</dd>
        </div>
      </dl>
      <h2>Install or build</h2>
      <p>{binding.requirements}</p>
      {
        binding.install && (
          <CodeBlock
            code={binding.install}
            language={binding.installLanguage ?? 'bash'}
            label={`${binding.language} installation`}
          />
        )
      }
      <p>
        See the <a href={guide}>binding installation guide</a> for integration steps
        and native-library setup.
      </p>
    </div>
  </section>
  <section class="section section--bordered">
    <div class="container reading stack">
      <h2>Release and support</h2>
      <p>
        <a href={productRelease}>{releaseLabel}</a> is the current product release.
        See the <a href={supportMatrix}>product support matrix</a> for the full scope
        of the {binding.support} tier.
      </p>
      <div class="cluster">
        <a class="button" href="/docs/compatibility/">Compatibility guidance</a>
      </div>
    </div>
  </section>
</BaseLayout>
