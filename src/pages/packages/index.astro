---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PackageCard from '@/components/PackageCard.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { bindings } from '@/data/bindings';
const title = 'STRling packages and language bindings';
const description =
  'Verified STRling package and source status for C, C++, C#, Dart, F#, Go, Java, Kotlin, Lua, Perl, PHP, Python, R, Ruby, Rust, Swift, and TypeScript.';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Packages', href: '/packages/' },
];
const counts = {
  published: bindings.filter((b) => b.status === 'Published').length,
  source: bindings.filter((b) => b.status === 'Source available').length,
  prepared: bindings.filter((b) => b.status === 'Publication prepared').length,
};
---

<BaseLayout
  {title}
  {description}
  pathname="/packages/"
  {crumbs}
  keywords={[
    'STRling packages',
    'regex library',
    'regex Python',
    'regex TypeScript',
  ]}
>
  <header class="page-hero">
    <div class="container reading stack">
      <Breadcrumbs items={crumbs} /><span class="eyebrow"
        >Binding ecosystem</span
      ><h1>STRling across 17 languages</h1><p>
        Registry publication, prepared packaging, and source availability are
        different states. This directory names them explicitly and only shows
        installation commands backed by public source.
      </p>
    </div>
  </header>
  <section class="section">
    <div class="container">
      <dl class="facts">
        <div class="fact">
          <dt>Published packages verified</dt><dd>{counts.published}</dd>
        </div><div class="fact">
          <dt>Source-available bindings</dt><dd>{counts.source}</dd>
        </div><div class="fact">
          <dt>Publication prepared</dt><dd>{counts.prepared}</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="section section--bordered">
    <div class="container stack">
      <div class="cluster">
        <StatusBadge label="Published" tone="published" /><StatusBadge
          label="Source available"
          tone="source"
        /><StatusBadge label="Publication prepared" tone="prepared" />
      </div><div class="package-grid">
        {bindings.map((binding) => <PackageCard {binding} />)}
      </div>
    </div>
  </section>
  <section class="section section--bordered">
    <div class="container">
      <h2 style="margin-bottom:1.5rem">Distribution matrix</h2><div
        style="overflow-x:auto"
      >
        <table class="package-table">
          <thead
            ><tr
              ><th>Binding</th><th>Distribution</th><th>Status</th><th
                >Verified registry version</th
              ><th>Fourth Edition</th></tr
            ></thead
          ><tbody
            >{
              bindings.map((binding) => (
                <tr>
                  <>
                    <td data-label="Binding">
                      <a href={`/packages/${binding.slug}/`}>
                        {binding.language}
                      </a>
                    </td>
                    <td data-label="Distribution">{binding.distribution}</td>
                    <td data-label="Status">{binding.status}</td>
                    <td data-label="Registry version">
                      {binding.registry?.version ?? 'Not asserted'}
                    </td>
                    <td data-label="Fourth Edition">Provisional</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </section>
  <section class="section section--bordered">
    <div class="container reading callout stack-sm">
      <strong>Evidence policy</strong><p>
        PyPI, npm, NuGet, Pub.dev, and RubyGems records listed here were
        verified against their live registries. Missing or unverified registry
        records are not treated as releases. Final Fourth Edition availability
        will be synchronized with the certified release matrix.
      </p>
    </div>
  </section>
</BaseLayout>
