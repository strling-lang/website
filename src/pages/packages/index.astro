---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PackageCard from '@/components/PackageCard.astro';
import { productRelease, releaseLabel, supportMatrix } from '@/data/release';
import { bindings } from '@/data/bindings';
const title = 'STRling packages and language bindings';
const description =
  'Verified STRling package and source status for C, C++, C#, Dart, F#, Go, Java, Kotlin, Lua, Perl, PHP, Python, R, Ruby, Rust, Swift, and TypeScript.';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Packages', href: '/packages/' },
];
---

<BaseLayout
  {title}
  {description}
  pathname="/packages/"
  {crumbs}
  keywords={[
    'STRling packages',
    'regex library',
    'regex Python',
    'regex TypeScript',
  ]}
>
  <header class="page-hero">
    <div class="container reading stack">
      <Breadcrumbs items={crumbs} /><span class="eyebrow"
        >Binding ecosystem</span
      ><h1>STRling across 17 languages</h1><p>
        This directory lists package versions, installation routes, and support
        tiers for <a href={productRelease}>{releaseLabel}</a>.
      </p>
    </div>
  </header>
  <section class="section">
    <div class="container">
      <div class="package-grid">
        {bindings.map((binding) => <PackageCard {binding} />)}
      </div>
    </div>
  </section>
  <section class="section section--bordered">
    <div class="container">
      <h2 style="margin-bottom:1.5rem">Distribution matrix</h2><div
        style="overflow-x:auto"
      >
        <table class="package-table">
          <thead
            ><tr
              ><th>Binding</th><th>Distribution</th><th>Status</th><th
                >Package version or tag</th
              ><th>Support tier</th></tr
            ></thead
          ><tbody
            >{
              bindings.map((binding) => (
                <tr>
                  <>
                    <td data-label="Binding">
                      <a href={`/packages/${binding.slug}/`}>
                        {binding.language}
                      </a>
                    </td>
                    <td data-label="Distribution">{binding.distribution}</td>
                    <td data-label="Status">{binding.status}</td>
                    <td data-label="Version or tag">
                      {binding.package.version}
                    </td>
                    <td data-label="Support tier">{binding.support}</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </section>
  <section class="section section--bordered">
    <div class="container reading callout stack-sm">
      <strong>Evidence policy</strong><p>
        Each tier applies to the runtimes and platforms in the <a
          href={supportMatrix}>product support matrix</a
        >. Open a binding for its verified distribution route and platform
        requirements.
      </p>
    </div>
  </section>
</BaseLayout>
