---
import Workbench from '@/components/lab/Workbench.astro';
import { surfaces } from '@/data/surfaces';
import BaseLayout from '@/layouts/BaseLayout.astro';

const surface = surfaces.regexLab;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'RegEx', href: '/regex/' },
  { label: surface.label, href: surface.route },
];
---

<BaseLayout
  title={surface.label}
  description={surface.description}
  pathname={surface.route}
  {crumbs}
>
  <Workbench mode="regex" {crumbs} title={surface.label} />
</BaseLayout>
